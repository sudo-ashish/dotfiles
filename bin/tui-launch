#!/usr/bin/env bash

tui="$1"

if [[ -z "$tui" ]]; then
  echo "Usage: $0 <tui-command>"
  exit 1
fi

class="tui-$tui"

address=$(
  hyprctl clients -j |
    jq -r --arg class "$class" \
      '.[] | select(.class == $class) | .address' |
    head -n1
)

if [[ -n "$address" ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })"
else
  kitty \
    --class "$class" \
    --title "$tui" \
    -e "$tui"
fi